# =============================================================================
# Copy to .env.local:   cp .env.example .env.local
# For `make migrate` / merged compose:   cp .env.local .env.dev   (same keys; --env-file .env.dev)
# For `make migrate-prod`:              cp .env.production .env.prod   (or maintain .env.prod)
#
# Docker Compose reads this file via --env-file .env.local and injects variables
# into containers. Interpolation like ${POSTGRES_USER} happens in docker-compose*.yml
# (Compose engine), not in Node via dotenv-expand.
#
# Service app-dev overrides DATABASE_URL / DIRECT_URL / REDIS_URL to use Docker
# hostnames (postgres-dev, redis-dev). Keep the localhost URLs below for Prisma
# CLI on the host (npm run migrate:dev, etc.) when DB is published on the host port.
# =============================================================================

# --- Docker Compose: published ports (host → container) ---
POSTGRES_HOST_PORT="5432"
REDIS_HOST_PORT="6379"
REDIS_COMMANDER_PORT="8081"
APP_DEV_PORT="3000"
PRISMA_STUDIO_PORT="5555"

# Production stack (`docker-compose.yml`)
APP_HOST_PORT="3000"

# --- Postgres / Redis credentials (used by Compose + postgres-dev / redis-dev) ---
POSTGRES_DB="app_dev"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="DevPg_Secret_ChangeMe_Required_At_Least_32_Chars"
POSTGRES_HOST_AUTH_METHOD="trust"

REDIS_PASSWORD="DevRedis_Secret_ChangeMe_Required_32_Chars_Min_xx"

# --- Host Prisma / Next (localhost = published DB/Redis ports) ---
POSTGRES_HOST="localhost"
POSTGRES_PORT="5432"
REDIS_HOST="localhost"
REDIS_PORT="6379"
DATABASE_URL="postgresql://postgres:DevPg_Secret_ChangeMe_Required_At_Least_32_Chars@localhost:5432/app_dev"
DIRECT_URL="postgresql://postgres:DevPg_Secret_ChangeMe_Required_At_Least_32_Chars@localhost:5432/app_dev"
REDIS_URL="redis://:DevRedis_Secret_ChangeMe_Required_32_Chars_Min_xx@localhost:6379"

# --- NextAuth / JWT (≥ 32 characters) ---
PORT="3000"
NEXTAUTH_URL="http://localhost:3000"
AUTH_URL="http://localhost:3000/api/auth"
NEXTAUTH_SECRET="DevNextAuth_Secret_ChangeMe_Min_32_Characters_Long_xxxx"
JWT_SECRET="DevJWT_Secret_ChangeMe_Min_32_Characters_Long_xxxxxxxxxx"

# --- App ---
NODE_ENV="development"
APP_VERSION="1.0.0"

# --- Email (optional) ---
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASS=""

# --- Google OAuth (optional) ---
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Upload / rate limit / logging ---
MAX_FILE_SIZE="5242880"
UPLOAD_DIR="./uploads"
RATE_LIMIT_WINDOW="900000"
RATE_LIMIT_MAX="100"
LOG_LEVEL="info"
LOG_FILE="./logs/app.log"
LOG_TO_FILE="false"

# --- Public (client) ---
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:3000/api"
NEXT_PUBLIC_APP_NAME="Next.js 16 Starter Template"
NEXT_PUBLIC_APP_VERSION="1.0.0"
NEXT_PUBLIC_LOG_LEVEL="info"
NEXT_PUBLIC_ENVIRONMENT="development"
